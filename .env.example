# Fi Collar Credentials (same as your Fi app login)
FI_USERNAME=your@email.com
FI_PASSWORD=yourpassword

# Home Location (right-click Google Maps → copy coordinates)
LATITUDE=40.7128
LONGITUDE=-74.0060
TIMEZONE=America/New_York

# Optional
PET_NAME=                      # defaults to first pet
CUTOFF_HOUR=1                  # stop checking at 1am local (0-23)
POLL_INTERVAL_MINUTES=2        # how often to check when dog is outside (fast)
SLOW_POLL_INTERVAL_MINUTES=5   # how often to check when dog is inside (slow)
LED_COLOR=7                    # Fi color code: 2=Red 3=Green 4=Blue 5=Purple 6=Yellow 7=Cyan 8=White
STATE_FILE=state.json          # where to store state locally

# GCP mode only (leave blank for local/Docker)
GCP_PROJECT_ID=
FIRESTORE_COLLECTION=fi_nightlight
